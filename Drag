local VERSION = "v4"
local STATUS_TEXT = "anti makro " .. VERSION .. " aktif"

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

-- 1. Buat UI indikator kecil "anti makro v4 aktif"
local function createStatusIndicator()
	local oldGui = playerGui:FindFirstChild("AntiMacroStatusIndicator")
	if oldGui then
		oldGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "AntiMacroStatusIndicator"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = playerGui

	local badge = Instance.new("TextLabel")
	badge.Name = "StatusLabel"
	badge.Text = STATUS_TEXT
	badge.Size = UDim2.new(0, 114, 0, 16)
	badge.Position = UDim2.new(0, 6, 0, 6)
	badge.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	badge.BackgroundTransparency = 0.25
	badge.TextColor3 = Color3.fromRGB(120, 255, 140)
	badge.Font = Enum.Font.Code
	badge.TextSize = 9
	badge.TextScaled = false
	badge.BorderSizePixel = 0
	badge.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = badge

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(120, 255, 140)
	stroke.Thickness = 0.8
	stroke.Transparency = 0.5
	stroke.Parent = badge
end

-- 2. Cek apakah elemen UI benar-benar terlihat di layar
local function isActuallyVisible(guiObj)
	local current = guiObj
	while current and current ~= playerGui do
		if current:IsA("ScreenGui") and not current.Enabled then
			return false
		elseif current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end
	return true
end

-- 3. Klik lewat sinyal Lua
local function fireSignalOnce(btn)
	if not btn then return false end

	if firesignal then
		local ok = pcall(function()
			firesignal(btn.Activated)
		end)
		if ok then
			pcall(function() firesignal(btn.MouseButton1Click) end)
			return true
		end
	end

	if getconnections then
		local fired = false
		for _, conn in ipairs(getconnections(btn.Activated)) do
			if pcall(function() conn:Fire() end) then
				fired = true
			end
		end
		if not fired then
			for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
				if pcall(function() conn:Fire() end) then
					fired = true
				end
			end
		end
		return fired
	end

	return false
end

-- 4. Klik lewat koordinat layar (Mouse + Touch fallback)
local function clickAtCenter(btn)
	if not btn or not btn:IsA("GuiObject") or not VirtualInputManager then
		return false
	end

	local pos = btn.AbsolutePosition
	local size = btn.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return false
	end

	local inset = GuiService:GetGuiInset()
	local cx = pos.X + (size.X * 0.5)
	local cy = pos.Y + (size.Y * 0.5) + inset.Y

	local okMouse = pcall(function()
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
		task.wait(0.06)
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
	end)

	local okTouch = pcall(function()
		VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.Begin.Value, cx, cy)
		task.wait(0.06)
		VirtualInputManager:SendTouchEvent(1, Enum.UserInputState.End.Value, cx, cy)
	end)

	return okMouse or okTouch
end

-- 5. Klik tombol bertahap: sinyal dulu, lalu koordinat jika target masih terlihat
local function smartClick(btn, checkTarget)
	if not btn then return end

	fireSignalOnce(btn)
	task.wait(0.25)

	if not checkTarget or isActuallyVisible(checkTarget) then
		clickAtCenter(btn)
	end
end

-- 6. Logika AFK CHECK (mencocokkan angka target dengan tombol angka)
local function solveNumberAntiMacro(antiMacroGui)
	local numberLabels = {}
	local numberButtons = {}

	for _, obj in ipairs(antiMacroGui:GetDescendants()) do
		if obj:IsA("TextLabel") and isActuallyVisible(obj) then
			local cleanText = tostring(obj.Text):match("^%s*(%d+)%s*$")
			if cleanText and not obj:FindFirstAncestorWhichIsA("TextButton") and not obj:FindFirstAncestorWhichIsA("ImageButton") then
				table.insert(numberLabels, {obj = obj, text = cleanText, size = obj.AbsoluteSize.Y})
			end
		elseif (obj:IsA("TextButton") or obj:IsA("ImageButton")) and isActuallyVisible(obj) then
			local btnText = obj:IsA("TextButton") and tostring(obj.Text):match("^%s*(%d+)%s*$") or nil
			if not btnText then
				local childLabel = obj:FindFirstChildWhichIsA("TextLabel", true)
				if childLabel then
					btnText = tostring(childLabel.Text):match("^%s*(%d+)%s*$")
				end
			end
			if btnText then
				table.insert(numberButtons, {btn = obj, text = btnText})
			end
		end
	end

	table.sort(numberLabels, function(a, b)
		return a.size > b.size
	end)

	local topLabel = numberLabels[1]
	if topLabel then
		for _, item in ipairs(numberButtons) do
			if item.text == topLabel.text then
				print("[Auto-AFK " .. VERSION .. "] Angka target:", topLabel.text, "-> Klik:", item.text)
				smartClick(item.btn, topLabel.obj)
				return true
			end
		end
	end

	return false
end

-- 7. Penanganan PausedBanner.TextButton ("REWARDS PAUSED")
local function solvePausedBanner(antiMacroGui)
	local pausedBanner = antiMacroGui:FindFirstChild("PausedBanner")
	if not pausedBanner or not isActuallyVisible(pausedBanner) then
		return false
	end

	local btn = pausedBanner:FindFirstChild("TextButton")
	if not (btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) and isActuallyVisible(btn)) then
		for _, desc in ipairs(pausedBanner:GetDescendants()) do
			if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and isActuallyVisible(desc) then
				btn = desc
				break
			end
		end
	end

	if btn then
		print("[Auto-AFK " .. VERSION .. "] Memproses PausedBanner:", btn:GetFullName())
		smartClick(btn, pausedBanner)
		return true
	end

	return false
end

-- 8. Fungsi utama pemindaian: klik angka dulu, lalu jeda 5 detik, baru klik reward paused
local isScanning = false

local function scanAndResolve()
	if isScanning then return end
	isScanning = true

	local didNumberAction = false

	for _, child in ipairs(playerGui:GetChildren()) do
		if child.Name == "AntiMacro" then
			if solveNumberAntiMacro(child) then
				didNumberAction = true
			end
		end
	end

	if didNumberAction then
		print("[Auto-AFK " .. VERSION .. "] Menunggu 5 detik sebelum memproses Reward Paused...")
		task.wait(5)
	end

	for _, child in ipairs(playerGui:GetChildren()) do
		if child.Name == "AntiMacro" then
			solvePausedBanner(child)
		end
	end

	task.wait(0.8)
	isScanning = false
end

-- 9. Pasang listener pada objek AntiMacro
local hookedGuis = setmetatable({}, {__mode = "k"})

local function hookAntiMacro(antiMacroGui)
	if hookedGuis[antiMacroGui] then return end
	hookedGuis[antiMacroGui] = true

	if antiMacroGui:IsA("ScreenGui") then
		antiMacroGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if antiMacroGui.Enabled then
				task.wait(0.35)
				scanAndResolve()
			end
		end)
	end

	antiMacroGui.DescendantAdded:Connect(function(desc)
		if desc:IsA("GuiObject") then
			task.wait(0.35)
			scanAndResolve()
		end
	end)

	for _, child in ipairs(antiMacroGui:GetDescendants()) do
		if child:IsA("GuiObject") then
			child:GetPropertyChangedSignal("Visible"):Connect(function()
				if child.Visible then
					task.wait(0.35)
					scanAndResolve()
				end
			end)
		end
	end
end

-- 10. Jalankan indikator & pemantauan berkelanjutan
createStatusIndicator()

for _, child in ipairs(playerGui:GetChildren()) do
	if child.Name == "AntiMacro" then
		hookAntiMacro(child)
	end
end

playerGui.ChildAdded:Connect(function(child)
	if child.Name == "AntiMacro" then
		hookAntiMacro(child)
		task.wait(0.35)
		scanAndResolve()
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		for _, child in ipairs(playerGui:GetChildren()) do
			if child.Name == "AntiMacro" then
				hookAntiMacro(child)
			end
		end
		scanAndResolve()
	end
end)
