local function getModelPosition(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.Position
        end
        local success, cf = pcall(function()
            return obj:GetBoundingBox()
        end)
        if success and cf then
            return cf.Position
        end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local startPlayback
local loadMacro

local recordedActions = {}
local recordedPlacePositions = {} 
local placedTowersCount = 0
local isRecording = false
local isPlaying = false
local lastPlayAgainTriggerTime = 0
local activeMatchTowers = {}

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    local res = {pcall(oldNamecall, self, unpack(args))}
    local success = res[1]
    local serverResult = res[2]
    
    if tostring(self.Name) == "PlayAgain" and (method == "FireServer" or method == "InvokeServer") then
        if autoPlayMatchEnabled and not isRecording then
            local currentTime = tick()
            if currentTime - lastPlayAgainTriggerTime > 15 then
                lastPlayAgainTriggerTime = currentTime
                
                task.spawn(function()
                    isPlaying = false
                    logMessage("PlayAgain diklik! Memulai ulang makro untuk match baru...", Color3.fromRGB(100, 200, 255))
                    task.wait(6)
                    
                    local macroName = nameBox.Text ~= "" and nameBox.Text or "makro_1"
                    if loadMacro(macroName) then
                        task.wait(1)
                        startPlayback()
                    end
                end)
            end
        end
    end
    
    if isRecording and (method == "InvokeServer" or method == "FireServer") then
        if success and serverResult ~= false then
            local remote = self
            local m = method
            local capturedArgs = {}
            for k, v in pairs(args) do
                capturedArgs[k] = v
            end
            
            task.spawn(function()
                pcall(function()
                    local remoteName = tostring(remote.Name):lower()
                    
                    local hasVector3 = false
                    local hasString = false
                    for _, arg in ipairs(capturedArgs) do
                        if typeof(arg) == "Vector3" then hasVector3 = true end
                        if typeof(arg) == "string" then hasString = true end
                    end
                    
                    if hasVector3 and hasString then
                        placedTowersCount = placedTowersCount + 1
                        local currentTowerIndex = placedTowersCount
                        
                        local placePos = nil
                        for _, arg in ipairs(capturedArgs) do
                            if typeof(arg) == "Vector3" then
                                placePos = arg
                                break
                            end
                        end
                        
                        recordedPlacePositions[currentTowerIndex] = placePos
                        
                        table.insert(recordedActions, {
                            Type = "Place",
                            TowerIndex = currentTowerIndex,
                            RemoteName = remote.Name,
                            Method = m,
                            Args = capturedArgs,
                            Position = placePos
                        })
                        
                        local towerName = tostring(capturedArgs[1]) or "Unknown"
                        local posStr = placePos and string.format("(%.1f, %.1f, %.1f)", placePos.X, placePos.Y, placePos.Z) or "Vector3"
                        logMessage(string.format("[RECORD] place tower #%d [%s] at %s", currentTowerIndex, towerName, posStr), Color3.fromRGB(255, 200, 100))
                        return
                    end
                    
                    local actionType = nil
                    if string.match(remoteName, "sell") or string.match(remoteName, "remove") or string.match(remoteName, "delete") then
                        actionType = "Sell"
                    elseif string.match(remoteName, "upgrade") or string.match(remoteName, "level") or string.match(remoteName, "up") then
                        actionType = "Upgrade"
                    end
                    
                    if actionType then
                        local targetInstance = nil
                        local subInstanceName = ""
                        
                        for _, arg in ipairs(capturedArgs) do
                            if typeof(arg) == "Instance" then
                                targetInstance = arg
                                break
                            end
                        end
                        
                        if targetInstance then
                            subInstanceName = targetInstance.Name
                        end
                        
                        local targetModel = targetInstance
                        if targetModel and not targetModel:IsA("Model") then
                            local modelParent = targetModel:FindFirstAncestorOfClass("Model")
                            if modelParent then
                                targetModel = modelParent
                            end
                        end
                        
                        local matchedIndex = 1
                        local objName = "Unknown"
                        
                        if targetModel then
                            pcall(function()
                                objName = targetModel.Name
                            end)
                            
                            local targetPos = getModelPosition(targetModel)
                            if targetPos then
                                local minDistance = math.huge
                                for idx, pos in pairs(recordedPlacePositions) do
                                    local dist = (pos - targetPos).Magnitude
                                    if dist < minDistance then
                                        minDistance = dist
                                        matchedIndex = idx
                                    end
                                end
                            end
                        end
                        
                        table.insert(recordedActions, {
                            Type = actionType,
                            TowerIndex = matchedIndex,
                            RemoteName = remote.Name,
                            Method = m,
                            ObjectName = objName,
                            SubInstanceName = subInstanceName,
                            Args = capturedArgs
                        })
                        
                        logMessage(string.format("[RECORD] %s tower #%d [%s] (Target Index: #%d)", actionType:lower(), #recordedActions, objName, matchedIndex), Color3.fromRGB(255, 200, 100))
                    end
                end)
            end)
        end
    end
    
    if not res[1] then
        error(res[2])
    end
    return unpack(res, 2)
end)

local function saveMacro()
    pcall(function()
        if writefile then
            local macroName = nameBox.Text ~= "" and nameBox.Text or "makro_1"
            local dataToSave = {
                Actions = {},
                Positions = {}
            }
            
            for _, act in ipairs(recordedActions) do
                local posData = act.Position and {X = act.Position.X, Y = act.Position.Y, Z = act.Position.Z} or nil
                local serializedArgs = {}
                if act.Args then
                    for k, v in pairs(act.Args) do
                        if typeof(v) == "Vector3" then
                            serializedArgs[k] = {__type = "Vector3", X = v.X, Y = v.Y, Z = v.Z}
                        elseif typeof(v) == "Instance" then
                            serializedArgs[k] = {__type = "TowerInstance"}
                        else
                            serializedArgs[k] = v
                        end
                    end
                end
                
                table.insert(dataToSave.Actions, {
                    Type = act.Type,
                    TowerIndex = act.TowerIndex,
                    RemoteName = act.RemoteName,
                    Method = act.Method,
                    ObjectName = act.ObjectName,
                    SubInstanceName = act.SubInstanceName,
                    Position = posData,
                    Args = serializedArgs
                })
            end
            
            for idx, pos in pairs(recordedPlacePositions) do
                dataToSave.Positions[tostring(idx)] = {X = pos.X, Y = pos.Y, Z = pos.Z}
            end
            
            local jsonString = HttpService:JSONEncode(dataToSave)
            writefile("TowerMacro_" .. macroName .. ".json", jsonString)
            
            saveConfig()
            logMessage("Berhasil menyimpan makro & config: " .. macroName, Color3.fromRGB(100, 255, 150))
        else
            logMessage("Executor tidak mendukung writefile!", Color3.fromRGB(255, 100, 100))
        end
    end)
end

loadMacro = function(macroName)
    local success, result = pcall(function()
        if readfile and isfile and isfile("TowerMacro_" .. macroName .. ".json") then
            local jsonString = readfile("TowerMacro_" .. macroName .. ".json")
            local decoded = HttpService:JSONDecode(jsonString)
            
            recordedActions = {}
            recordedPlacePositions = {}
            
            for _, act in ipairs(decoded.Actions) do
                local deserializedArgs = {}
                if act.Args then
                    for k, v in pairs(act.Args) do
                        if type(v) == "table" and v.__type == "Vector3" then
                            deserializedArgs[k] = Vector3.new(v.X, v.Y, v.Z)
                        elseif type(v) == "table" and v.__type == "TowerInstance" then
                            deserializedArgs[k] = "__TOWER_INSTANCE__"
                        else
                            deserializedArgs[k] = v
                        end
                    end
                end
                
                local realPos = act.Position and Vector3.new(act.Position.X, act.Position.Y, act.Position.Z) or nil
                local remoteObj = ReplicatedStorage:FindFirstChild(act.RemoteName, true)
                
                table.insert(recordedActions, {
                    Type = act.Type,
                    TowerIndex = act.TowerIndex,
                    Remote = remoteObj,
                    RemoteName = act.RemoteName,
                    Method = act.Method,
                    ObjectName = act.ObjectName,
                    SubInstanceName = act.SubInstanceName,
                    Position = realPos,
                    Args = deserializedArgs
                })
            end
            
            for idxStr, posTbl in pairs(decoded.Positions) do
                recordedPlacePositions[tonumber(idxStr)] = Vector3.new(posTbl.X, posTbl.Y, posTbl.Z)
            end
            
            logMessage("Berhasil memuat makro: " .. macroName .. " (" .. #recordedActions .." aksi)", Color3.fromRGB(100, 200, 255))
            return true
        end
        return false
    end)
    return success and result
end

startPlayback = function()
    if isRecording then
        logMessage("Hentikan record terlebih dahulu!", Color3.fromRGB(255, 100, 100))
        return
    end
    if isPlaying then
        logMessage("Makro sedang berjalan!", Color3.fromRGB(255, 100, 100))
        return
    end
    if #recordedActions == 0 then
        logMessage("Tidak ada data makro yang dimuat!", Color3.fromRGB(255, 100, 100))
        return
    end

    isPlaying = true
    activeMatchTowers = {}
    playBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    playBtn.Text = "Playing..."
    logMessage(string.format("Memulai playback (%d aksi)...", #recordedActions), Color3.fromRGB(50, 200, 90))

    task.spawn(function()
        for i, action in ipairs(recordedActions) do
            if not isPlaying then break end

            local actionDesc = ""
            if action.Type == "Place" then
                local towerName = tostring(action.Args[1]) or "Tower"
                actionDesc = string.format("place tower #%d [%s]", action.TowerIndex, towerName)
            elseif action.Type == "Upgrade" then
                actionDesc = string.format("upgrade tower #%d [%s]", action.TowerIndex, action.ObjectName)
            elseif action.Type == "Sell" then
                actionDesc = string.format("sell tower #%d [%s]", action.TowerIndex, action.ObjectName)
            end

            logMessage(string.format("[PLAY] Menunggu kondisi untuk %s...", actionDesc), Color3.fromRGB(200, 200, 100))

            local success = false
            local attempts = 0
            while isPlaying and not success do
                attempts = attempts + 1
                local ok, res = pcall(function()
                    local remote = action.Remote
                    if not remote or not remote.Parent then
                        remote = ReplicatedStorage:FindFirstChild(action.RemoteName, true)
                    end
                    if not remote then return false end

                    if action.Type == "Place" then
                        local existingModels = {}
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") then
                                existingModels[obj] = true
                            end
                        end

                        if action.Method == "InvokeServer" then
                            remote:InvokeServer(unpack(action.Args))
                        else
                            remote:FireServer(unpack(action.Args))
                        end
                        
                        task.wait(0.5)
                        
                        local placedObj = nil
                        local startTime = tick()
                        while tick() - startTime < 3 and not placedObj do
                            for _, obj in ipairs(workspace:GetDescendants()) do
                                if obj:IsA("Model") and obj.Parent ~= nil and not existingModels[obj] then
                                    local alreadyAssigned = false
                                    for _, assigned in pairs(activeMatchTowers) do
                                        if assigned == obj then
                                            alreadyAssigned = true
                                            break
                                        end
                                    end
                                    if not alreadyAssigned then
                                        placedObj = obj
                                        break
                                    end
                                end
                            end
                            if not placedObj then
                                task.wait(0.1)
                            end
                        end
                        
                        if not placedObj and action.Position then
                            local minDst = math.huge
                            for _, obj in ipairs(workspace:GetDescendants()) do
                                if obj:IsA("Model") and obj.Parent ~= nil then
                                    local alreadyAssigned = false
                                    for _, assigned in pairs(activeMatchTowers) do
                                        if assigned == obj then
                                            alreadyAssigned = true
                                            break
                                        end
                                    end
                                    if not alreadyAssigned then
                                        local pos = getModelPosition(obj)
                                        if pos then
                                            local dist = (pos - action.Position).Magnitude
                                            if dist < 12 and dist < minDst then
                                                minDst = dist
                                                placedObj = obj
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        
                        if placedObj then
                            activeMatchTowers[action.TowerIndex] = placedObj
                            return true
                        else
                            return false
                        end
                    elseif action.Type == "Upgrade" or action.Type == "Sell" then
                        local targetObj = activeMatchTowers[action.TowerIndex]
                        
                        if not targetObj or not targetObj.Parent then
                            local targetPos = recordedPlacePositions[action.TowerIndex]
                            if targetPos then
                                local minDst = math.huge
                                for _, obj in ipairs(workspace:GetDescendants()) do
                                    if obj:IsA("Model") and obj.Parent ~= nil then
                                        local pos = getModelPosition(obj)
                                        if pos then
                                            local dist = (pos - targetPos).Magnitude
                                            if dist < 15 and dist < minDst then
                                                minDst = dist
                                                targetObj = obj
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if targetObj then
                            -- SMART FALLBACK FIX: Gunakan sub-instance jika ada, jika tidak, fallback aman ke Model Utama (targetObj)
                            local finalTarget = targetObj
                            if action.SubInstanceName and action.SubInstanceName ~= "" then
                                local foundSub = targetObj:FindFirstChild(action.SubInstanceName, true)
                                if foundSub then
                                    finalTarget = foundSub
                                else
                                    finalTarget = targetObj
                                end
                            end

                            local playArgs = {}
                            if action.Args then
                                for k, v in pairs(action.Args) do
                                    playArgs[k] = v
                                end
                                for k, v in pairs(playArgs) do
                                    if v == "__TOWER_INSTANCE__" or typeof(v) == "Instance" then
                                        playArgs[k] = finalTarget
                                    end
                                end
                            else
                                playArgs = {finalTarget}
                            end

                            local resVal
                            if action.Method == "InvokeServer" then
                                resVal = remote:InvokeServer(unpack(playArgs))
                            else
                                remote:FireServer(unpack(playArgs))
                                resVal = true
                            end

                            if action.Type == "Upgrade" and resVal ~= false then
                                task.wait(0.4)
                                local targetPos = recordedPlacePositions[action.TowerIndex]
                                if targetPos then
                                    local minDst = math.huge
                                    local updatedObj = nil
                                    for _, obj in ipairs(workspace:GetDescendants()) do
                                        if obj:IsA("Model") and obj.Parent ~= nil and obj ~= targetObj then
                                            local pos = getModelPosition(obj)
                                            if pos then
                                                local dist = (pos - targetPos).Magnitude
                                                if dist < 8 and dist < minDst then
                                                    minDst = dist
                                                    updatedObj = obj
                                                end
                                            end
                                        end
                                    end
                                    if updatedObj then
                                        activeMatchTowers[action.TowerIndex] = updatedObj
                                    end
                                end
                            end

                            return resVal
                        else
                            return false
                        end
                    end
                end)

                if ok and res ~= false then
                    success = true
                else
                    if attempts == 30 then
                        logMessage(string.format("[WARNING] Tower #%d belum siap untuk %s...", action.TowerIndex or 0, actionDesc), Color3.fromRGB(255, 150, 50))
                    end
                    task.wait(0.5)
                end
            end

            if not isPlaying then break end
            logMessage(string.format("[PLAY] Berhasil %s", actionDesc), Color3.fromRGB(100, 255, 150))
        end

        isPlaying = false
        playBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
        playBtn.Text = "Play"
        logMessage("Playback selesai!", Color3.fromRGB(100, 255, 150))
    end)
end

