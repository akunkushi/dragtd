-- Core Playback Function
local function startPlayback()
    if isRecording then
        addLog("Stop recording first!")
        return
    end
    
    if isPlaying then
        addLog("Already playing macro!")
        return
    end
    
    -- Jika recordedActions kosong saat Play ditekan, coba load otomatis dari kotak teks
    if #recordedActions == 0 then
        loadSelectedMacro()
    end
    
    if #recordedActions == 0 then
        addLog("No recorded actions found to play!")
        return
    end
    
    isPlaying = true
    PlayBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
    PlayBtn.Text = "Playing..."
    StatusLabel.Text = "Status: Playing..."
    addLog(string.format("Starting playback of '%s' (%d actions)...", selectedMacroName, #recordedActions))
    
    task.spawn(function()
        task.wait(3) -- Jeda agar match baru siap sepenuhnya
        
        for i, action in ipairs(recordedActions) do
            if not isPlaying then break end
            
            local actionType = action.actionType
            
            -- Cari remote secara dinamis
            local successRemote = false
            local remote = nil
            local startTime = tick()
            while isPlaying and not successRemote and (tick() - startTime < 15) do
                pcall(function()
                    local main = ReplicatedStorage:WaitForChild("Main", 2)
                    local rm = main and main:WaitForChild("Remotes", 2)
                    remote = rm and rm:WaitForChild(actionType, 2)
                end)
                
                if remote then
                    successRemote = true
                else
                    task.wait(0.5)
                end
            end
            
            local success = false
            local desc = actionType
            if actionType == "PlaceTroop" and type(action.args[1]) == "table" and action.args[1].species then
                desc = "Place " .. tostring(action.args[1].species)
            elseif actionType == "UpgradeTroop" then
                desc = "Upgrade " .. tostring(action.args[1])
            elseif actionType == "SellTroop" then
                desc = "Sell " .. tostring(action.args[1])
            end
            
            -- STRICT RETRY LOOP
            while isPlaying and not success do
                if remote then
                    local res, serverResult = pcall(function()
                        return remote:InvokeServer(unpack(deserialize(action.args)))
                    end)
                    
                    if res and serverResult ~= false then
                        success = true
                        addLog(string.format("[PLAY] Success %s (#%d)", desc, i))
                        task.wait(0.4)
                    else
                        addLog(string.format("[PLAY] Waiting for Cash/State -> %s (#%d)", desc, i))
                        task.wait(0.8)
                    end
                else
                    addLog(string.format("[PLAY] Error: Remote %s not found!", actionType))
                    task.wait(2)
                end
            end
        end
        
        isPlaying = false
        PlayBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
        PlayBtn.Text = "Play"
        StatusLabel.Text = string.format("Status: Idle | Actions: %d", #recordedActions)
        addLog("Playback finished.")
    end)
end

