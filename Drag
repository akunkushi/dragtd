-- Serialization for Vector3 in JSON
local function serialize(val)
    local t = typeof(val)
    if t == "Vector3" then
        return {__type = "Vector3", x = val.X, y = val.Y, z = val.Z}
    elseif t == "table" then
        local tbl = {}
        for k, v in pairs(val) do
            tbl[tostring(serialize(k))] = serialize(v)
        end
        return tbl
    else
        return val
    end
end

-- Deserialize JSON back to Luau types
local function deserialize(val)
    if type(val) == "table" then
        if val.__type == "Vector3" then
            return Vector3.new(val.x, val.y, val.z)
        else
            local tbl = {}
            for k, v in pairs(val) do
                local realKey = tonumber(k) or k
                tbl[realKey] = deserialize(v)
            end
            return tbl
        end
    else
        return val
    end
end

local function deepCopy(orig)
    local orig_type = type(orig)
    local copy
    if orig_type == 'table' then
        copy = {}
        for orig_key, orig_value in next, orig, nil do
            copy[deepCopy(orig_key)] = deepCopy(orig_value)
        end
        setmetatable(copy, deepCopy(getmetatable(orig)))
    else
        copy = orig
    end
    return copy
end

