local function getModelPosition(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position end
        local success, cf = pcall(function() return obj:GetBoundingBox() end)
        if success and cf then return cf.Position end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local recordedActions = {}
local recordedPlacePositions = {}
local isRecording = false
local isPlaying = false

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    local res = {pcall(oldNamecall, self, unpack(args))}
    local success = res[1]
    local serverResult = res[2]
    
    if isRecording and (method == "InvokeServer" or method == "FireServer") then
        if success and serverResult ~= false then
            local remote = self
            local m = method
            local capturedArgs = {}
            for k, v in pairs(args) do capturedArgs[k] = v end
            
            task.spawn(function()
                pcall(function()
                    local remoteName = tostring(remote.Name):lower()
                    local hasVector3 = false
                    local hasString = false
                    for _, arg in ipairs(capturedArgs) do
                        if typeof(arg) == "Vector3" then hasVector3 = true end
                        if typeof(arg) == "string" then hasString = true end
                    end
                    
                    if hasVector3 and hasString then
                        local placePos = nil
                        for _, arg in ipairs(capturedArgs) do
                            if typeof(arg) == "Vector3" then
                                placePos = arg
                                break
                            end
                        end
                        
                        table.insert(recordedActions, {
                            Type = "Place",
                            RemoteName = remote.Name,
                            Method = m,
                            Args = capturedArgs,
                            Position = placePos
                        })
                        logMessage("[RECORD] Place Tower", Color3.fromRGB(255, 200, 100))
                        return
                    end
                    
                    local actionType = nil
                    if string.match(remoteName, "sell") or string.match(remoteName, "remove") then
                        actionType = "Sell"
                    elseif string.match(remoteName, "upgrade") or string.match(remoteName, "evolve") or string.match(remoteName, "level") or string.match(remoteName, "up") then
                        actionType = "Upgrade"
                    end
                    
                    if actionType then
                        local targetModel = nil
                        for _, arg in ipairs(capturedArgs) do
                            if typeof(arg) == "Instance" then
                                targetModel = arg
                                break
                            end
                        end
                        
                        local targetPos = nil
                        if targetModel then
                            if not targetModel:IsA("Model") then
                                local parent = targetModel:FindFirstAncestorOfClass("Model")
                                if parent then targetModel = parent end
                            end
                            targetPos = getModelPosition(targetModel)
                        end
                        
                        table.insert(recordedActions, {
                            Type = actionType,
                            RemoteName = remote.Name,
                            Method = m,
                            Position = targetPos,
                            Args = capturedArgs
                        })
                        logMessage("[RECORD] " .. actionType, Color3.fromRGB(255, 200, 100))
                    end
                end)
            end)
        end
    end
    
    if not res[1] then error(res[2]) end
    return unpack(res, 2)
end)

local function saveMacro()
    pcall(function()
        if writefile then
            local macroName = nameBox.Text ~= "" and nameBox.Text or "makro_basic"
            local dataToSave = {}
            for _, act in ipairs(recordedActions) do
                local posData = act.Position and {X = act.Position.X, Y = act.Position.Y, Z = act.Position.Z} or nil
                local serializedArgs = {}
                for k, v in pairs(act.Args or {}) do
                    if typeof(v) == "Vector3" then
                        serializedArgs[k] = {__type = "Vector3", X = v.X, Y = v.Y, Z = v.Z}
                    elseif typeof(v) == "Instance" then
                        serializedArgs[k] = {__type = "Instance"}
                    else
                        serializedArgs[k] = v
                    end
                end
                table.insert(dataToSave, {
                    Type = act.Type,
                    RemoteName = act.RemoteName,
                    Method = act.Method,
                    Position = posData,
                    Args = serializedArgs
                })
            end
            writefile("TowerMacro_" .. macroName .. ".json", HttpService:JSONEncode(dataToSave))
            logMessage("Makro disimpan: " .. macroName, Color3.fromRGB(100, 255, 150))
        end
    end)
end

local function loadMacro()
    pcall(function()
        local macroName = nameBox.Text ~= "" and nameBox.Text or "makro_basic"
        local fileName = "TowerMacro_" .. macroName .. ".json"
        if readfile and isfile and isfile(fileName) then
            local decoded = HttpService:JSONDecode(readfile(fileName))
            recordedActions = {}
            for _, act in ipairs(decoded) do
                local deserializedArgs = {}
                for k, v in pairs(act.Args or {}) do
                    if type(v) == "table" and v.__type == "Vector3" then
                        deserializedArgs[k] = Vector3.new(v.X, v.Y, v.Z)
                    elseif type(v) == "table" and v.__type == "Instance" then
                        deserializedArgs[k] = "__INSTANCE__"
                    else
                        deserializedArgs[k] = v
                    end
                end
                local pos = act.Position and Vector3.new(act.Position.X, act.Position.Y, act.Position.Z) or nil
                table.insert(recordedActions, {
                    Type = act.Type,
                    RemoteName = act.RemoteName,
                    Method = act.Method,
                    Position = pos,
                    Args = deserializedArgs
                })
            end
            logMessage("Makro dimuat: " .. macroName .. " (" .. #recordedActions .." aksi)", Color3.fromRGB(100, 200, 255))
        end
    end)
end

local function startPlayback()
    if isRecording or isPlaying or #recordedActions == 0 then return end
    isPlaying = true
    playBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    playBtn.Text = "Playing..."
    logMessage("Memulai Playback...", Color3.fromRGB(50, 200, 90))

    task.spawn(function()
        for _, action in ipairs(recordedActions) do
            if not isPlaying then break end
            
            local success = false
            while isPlaying and not success do
                local ok, res = pcall(function()
                    local remote = ReplicatedStorage:FindFirstChild(action.RemoteName, true)
                    if not remote then return false end
                    
                    if action.Type == "Place" then
                        if action.Method == "InvokeServer" then
                            remote:InvokeServer(unpack(action.Args))
                        else
                            remote:FireServer(unpack(action.Args))
                        end
                        task.wait(1)
                        return true
                    else
                        -- Cari objek berdasarkan posisi terdekat di match ini
                        local targetObj = nil
                        if action.Position then
                            local minDst = math.huge
                            for _, obj in ipairs(workspace:GetDescendants()) do
                                if obj:IsA("Model") and obj.Parent ~= nil then
                                    local pos = getModelPosition(obj)
                                    if pos then
                                        local dst = (pos - action.Position).Magnitude
                                        if dst < 15 and dst < minDst then
                                            minDst = dst
                                            targetObj = obj
                                        end
                                    end
                                end
                            end
                        end
                        
                        if targetObj then
                            local playArgs = {}
                            for k, v in pairs(action.Args) do
                                if v == "__INSTANCE__" or typeof(v) == "Instance" then
                                    playArgs[k] = targetObj
                                else
                                    playArgs[k] = v
                                end
                            end
                            
                            local resVal
                            if action.Method == "InvokeServer" then
                                resVal = remote:InvokeServer(unpack(playArgs))
                            else
                                remote:FireServer(unpack(playArgs))
                                resVal = true
                            end
                            
                            if resVal ~= false then
                                task.wait(1)
                                return true
                            end
                        end
                        return false
                    end
                end)
                
                if ok and res ~= false then
                    success = true
                else
                    task.wait(1)
                end
            end
        end
        isPlaying = false
        playBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
        playBtn.Text = "Play"
        logMessage("Playback Selesai!", Color3.fromRGB(100, 255, 150))
    end)
end

