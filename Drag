local Players = game:GetService("Players")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

-- 1. Buat UI indikator kecil "anti makro aktif"
local function createStatusIndicator()
	local oldGui = playerGui:FindFirstChild("AntiMacroStatusIndicator")
	if oldGui then
		oldGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "AntiMacroStatusIndicator"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = playerGui

	local badge = Instance.new("TextLabel")
	badge.Name = "StatusLabel"
	badge.Text = "anti makro aktif"
	badge.Size = UDim2.new(0, 92, 0, 16)
	badge.Position = UDim2.new(0, 6, 0, 6)
	badge.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	badge.BackgroundTransparency = 0.25
	badge.TextColor3 = Color3.fromRGB(120, 255, 140)
	badge.Font = Enum.Font.Code
	badge.TextSize = 9
	badge.TextScaled = false
	badge.BorderSizePixel = 0
	badge.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = badge

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(120, 255, 140)
	stroke.Thickness = 0.8
	stroke.Transparency = 0.5
	stroke.Parent = badge
end

-- 2. Fungsi klik tombol di berbagai jenis executor
local function clickButton(btn)
	if firesignal then
		firesignal(btn.MouseButton1Click)
		firesignal(btn.Activated)
	elseif getconnections then
		for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
			conn:Fire()
		end
		for _, conn in ipairs(getconnections(btn.Activated)) do
			conn:Fire()
		end
	end
end

-- 3. Cek apakah elemen UI benar-benar terlihat di layar
local function isActuallyVisible(guiObj)
	local current = guiObj
	while current and current ~= playerGui do
		if current:IsA("ScreenGui") and not current.Enabled then
			return false
		elseif current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end
	return true
end

-- 4. Fungsi utama memproses UI AntiMacro
local isSolving = false

local function solveAntiMacro(antiMacroGui)
	if isSolving then return end
	if not antiMacroGui or not antiMacroGui.Parent then return end
	if antiMacroGui:IsA("ScreenGui") and not antiMacroGui.Enabled then return end

	isSolving = true
	task.wait(0.6) -- Tunggu animasi pop-up dan angka selesai muncul

	local numberLabels = {}
	local numberButtons = {}

	for _, obj in ipairs(antiMacroGui:GetDescendants()) do
		if obj:IsA("TextLabel") and isActuallyVisible(obj) then
			local cleanText = tostring(obj.Text):match("^%s*(%d+)%s*$")
			if cleanText and not obj:FindFirstAncestorWhichIsA("TextButton") and not obj:FindFirstAncestorWhichIsA("ImageButton") then
				table.insert(numberLabels, {obj = obj, text = cleanText, size = obj.AbsoluteSize.Y})
			end
		elseif (obj:IsA("TextButton") or obj:IsA("ImageButton")) and isActuallyVisible(obj) then
			local btnText = obj:IsA("TextButton") and tostring(obj.Text):match("^%s*(%d+)%s*$") or nil
			if not btnText then
				local childLabel = obj:FindFirstChildWhichIsA("TextLabel", true)
				if childLabel then
					btnText = tostring(childLabel.Text):match("^%s*(%d+)%s*$")
				end
			end
			if btnText then
				table.insert(numberButtons, {btn = obj, text = btnText})
			end
		end
	end

	table.sort(numberLabels, function(a, b)
		return a.size > b.size
	end)

	local targetNumber = numberLabels[1] and numberLabels[1].text
	if targetNumber then
		for _, item in ipairs(numberButtons) do
			if item.text == targetNumber then
				print("[Auto-AFK] Angka target:", targetNumber, "-> Mengklik tombol:", item.text)
				clickButton(item.btn)
				break
			end
		end
	end

	task.wait(1) -- Cooldown singkat agar tidak spam klik
	isSolving = false
end

-- 5. Pasang listener pada objek AntiMacro
local hookedGuis = setmetatable({}, {__mode = "k"})

local function hookAntiMacro(antiMacroGui)
	if hookedGuis[antiMacroGui] then return end
	hookedGuis[antiMacroGui] = true

	-- Jalankan jika langsung aktif saat ditemukan
	solveAntiMacro(antiMacroGui)

	-- Pantau jika ScreenGui di-enable kembali
	if antiMacroGui:IsA("ScreenGui") then
		antiMacroGui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if antiMacroGui.Enabled then
				solveAntiMacro(antiMacroGui)
			end
		end)
	end

	-- Pantau jika Frame/label baru ditambahkan ke dalam AntiMacro
	antiMacroGui.DescendantAdded:Connect(function(desc)
		if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
			solveAntiMacro(antiMacroGui)
		end
	end)

	-- Pantau jika ada Frame utama di dalam AntiMacro yang Visible-nya berubah jadi true
	for _, child in ipairs(antiMacroGui:GetChildren()) do
		if child:IsA("GuiObject") then
			child:GetPropertyChangedSignal("Visible"):Connect(function()
				if child.Visible then
					solveAntiMacro(antiMacroGui)
				end
			end)
		end
	end
end

-- 6. Jalankan indikator & pantau terus-menerus
createStatusIndicator()

-- Cek semua AntiMacro yang sudah ada di PlayerGui sejak awal
for _, child in ipairs(playerGui:GetChildren()) do
	if child.Name == "AntiMacro" then
		hookAntiMacro(child)
	end
end

-- Pantau jika ada AntiMacro baru yang ditambahkan belakangan
playerGui.ChildAdded:Connect(function(child)
	if child.Name == "AntiMacro" then
		hookAntiMacro(child)
	end
end)

-- Loop cadangan (setiap 1 detik) untuk memastikan tidak ada pop-up yang terlewat
task.spawn(function()
	while true do
		task.wait(1)
		local antiMacro = playerGui:FindFirstChild("AntiMacro")
		if antiMacro then
			hookAntiMacro(antiMacro)
			solveAntiMacro(antiMacro)
		end
	end
end)
