-- Save Macro Function
local function saveCurrentMacro()
    local name = SaveBox.Text
    if name == "" then name = "macro_default" end
    selectedMacroName = name
    
    local success, err = pcall(function()
        local serialized = serialize(recordedActions)
        local encoded = HttpService:JSONEncode(serialized)
        writefile("TD_Macro_Saves/" .. name .. ".json", encoded)
    end)
    
    if success then
        addLog("Successfully saved: " .. name .. " (" .. #recordedActions .. " actions)")
    else
        addLog("Failed to save macro: " .. tostring(err))
    end
end

SaveBtn.MouseButton1Click:Connect(saveCurrentMacro)

-- Load Macro Function
local function loadSelectedMacro()
    local name = SaveBox.Text
    if name == "" then name = "macro_default" end
    selectedMacroName = name
    
    local path = "TD_Macro_Saves/" .. name .. ".json"
    if isfile(path) then
        local success, err = pcall(function()
            recordedActions = deserialize(HttpService:JSONDecode(readfile(path)))
        end)
        if success then
            addLog("Loaded macro: " .. name .. " (" .. #recordedActions .. " actions)")
            StatusLabel.Text = string.format("Status: Idle | Actions: %d", #recordedActions)
        else
            addLog("Failed to load JSON: " .. tostring(err))
        end
    else
        addLog("Macro file not found: " .. name)
    end
end

LoadBtn.MouseButton1Click:Connect(loadSelectedMacro)

