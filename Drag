-- Namecall Hook to Record Successful Actions
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local selfName = typeof(self) == "Instance" and self.Name or ""
    local args = {...}
    
    if isRecording and method == "InvokeServer" then
        if selfName == "PlaceTroop" or selfName == "UpgradeTroop" or selfName == "SellTroop" then
            local results = {pcall(function()
                return oldNamecall(self, unpack(args))
            end)}
            local success = results[1]
            local serverResult = results[2]
            
            setnamecallmethod(method)
            
            if success and serverResult ~= false then
                local copiedArgs = deepCopy(args)
                task.spawn(function()
                    pcall(function()
                        table.insert(recordedActions, {
                            actionType = selfName,
                            args = copiedArgs
                        })
                        
                        local desc = selfName
                        if selfName == "PlaceTroop" and type(copiedArgs[1]) == "table" and copiedArgs[1].species then
                            desc = "Place " .. tostring(copiedArgs[1].species)
                        elseif selfName == "UpgradeTroop" then
                            desc = "Upgrade " .. tostring(copiedArgs[1])
                        elseif selfName == "SellTroop" then
                            desc = "Sell " .. tostring(copiedArgs[1])
                        end
                        
                        addLog("[REC] Success " .. desc)
                        StatusLabel.Text = string.format("Status: Rec | Actions: %d", #recordedActions)
                    end)
                end)
                return unpack(results, 2)
            else
                return unpack(results, 2)
            end
        end
    end
    
    setnamecallmethod(method)
    return oldNamecall(self, ...)
end)

